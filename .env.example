# Resend API Key for sending emails and managing contacts
RESEND_API_KEY="re_123456789..."

# The email address that will show up as the sender (must be verified in Resend)
RESEND_FROM_EMAIL="newsletter@yourdomain.com"

# The base URL of your website (used for generating links in emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4 measurement ID (Admin -> Data streams -> your web stream).
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Local PostgreSQL Database connection string
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/newsletter?schema=public"
